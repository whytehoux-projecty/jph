// JPHeritage Unified Digital Bank Demo Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Admin & User Management
// -----------------------------------------------------------------------------

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      String   @default("ADMIN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  password            String
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  phone               String?
  dateOfBirth         DateTime @map("date_of_birth")
  address             String?
  city                String?
  state               String?
  zipCode             String?  @map("zip_code")
  status              String   @default("ACTIVE")
  tier                String   @default("BASIC")
  hasOnlineAccess     Boolean  @default(false) @map("has_online_access")
  preferredLanguage   String   @default("en") @map("preferred_language")
  preferredCurrency   String   @default("USD") @map("preferred_currency")
  twoFactorEnabled    Boolean  @default(false) @map("two_factor_enabled")
  transactionPin      String?  @map("transaction_pin")
  pinSetupComplete    Boolean  @default(false) @map("pin_setup_complete")
  isFirstLogin        Boolean  @default(true) @map("is_first_login")
  temporaryPassword   String?  @map("temporary_password")
  cryptoWalletEnabled Boolean  @default(false) @map("crypto_wallet_enabled")
  profilePhotoUrl     String?  @map("profile_photo_url")
  isFlagged           Boolean  @default(false) @map("is_flagged")
  eportalStatus       String   @default("ACTIVE") @map("eportal_status")
  eportalNotificationMessage String? @map("eportal_notification_message")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  accounts         Account[]
  beneficiaries    Beneficiary[]
  savingsGoals     SavingsGoal[]
  payees           Payee[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  cryptoWallets    CryptoWallet[]
  chequeRequests ChequeRequest[]
  registrationForm RegistrationForm?
  budgets          Budget[]
  creditScores     CreditScore[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// Account Management
// -----------------------------------------------------------------------------

model Account {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  accountNumber String   @unique @map("account_number")
  accountType   String   @map("account_type")
  currency      String   @default("USD")
  balance       Float    @default(0.00) // Using Float for SQLite
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  cards        Card[]
  bills        Bill[]
  statements   Statement[]
  cheques      Cheque[]
  chequeRequests ChequeRequest[]

  @@map("accounts")
}

model CryptoWallet {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  currency  String // e.g., "USDC", "USDT"
  balance   Float    @default(0.00)
  address   String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crypto_wallets")
}

// -----------------------------------------------------------------------------
// Onboarding & Approval Workflows
// -----------------------------------------------------------------------------

model AccountApplication {
  id                    String   @id @default(cuid())
  applicationType       String   @map("application_type") // PERSONAL, BUSINESS
  desiredAccountType    String?  @map("desired_account_type")
  isExistingCustomer    Boolean  @default(false) @map("is_existing_customer")
  isUsCitizenOrResident Boolean  @default(false) @map("is_us_citizen_or_resident")
  consentComms          Boolean  @default(false) @map("consent_comms")
  consentPrivacy        Boolean  @default(false) @map("consent_privacy")
  firstName             String   @map("first_name")
  lastName              String   @map("last_name")
  email                 String
  phone                 String
  dateOfBirth           DateTime @map("date_of_birth")
  nationality           String?
  currencyPreference    String?  @default("USD") @map("currency_preference")
  address               String
  city                  String
  state                 String
  zipCode               String   @map("zip_code")
  employmentStatus      String   @map("employment_status")
  annualIncome          Float    @map("annual_income")

  // File Uploads
  idDocumentUrl    String? @map("id_document_url")
  livenessImageUrl String? @map("liveness_image_url")

  // Staff Verification
  verificationRequired Boolean   @default(false) @map("verification_required")
  scheduledMeetingAt   DateTime? @map("scheduled_meeting_at")
  meetingMethod        String?   @map("meeting_method")
  meetingLink          String?   @map("meeting_link")

  registrationToken  String?           @unique @map("registration_token")
  registrationForm   RegistrationForm? @relation(fields: [registrationFormId], references: [id])
  registrationFormId String?           @unique @map("registration_form_id")

  status     String    @default("PENDING") // PENDING, VERIFICATION_REQUIRED, APPROVED, REJECTED
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("account_applications")
}

model RegistrationForm {
  id String @id @default(cuid())

  // 1. Full Personal Identification (KYC)
  title             String?
  gender            String?
  maritalStatus     String?   @map("marital_status")
  nationality       String?
  countryOfResidence String?  @map("country_of_residence")
  fullLegalName     String   @map("full_legal_name")
  dateOfBirth       DateTime @map("date_of_birth")
  ssnItin           String   @map("ssn_itin")
  mothersMaidenName String   @map("mothers_maiden_name")

  // 1b. Next of Kin Details
  nextOfKinName         String? @map("next_of_kin_name")
  nextOfKinRelationship String? @map("next_of_kin_relationship")
  nextOfKinPhone        String? @map("next_of_kin_phone")
  nextOfKinAddress      String? @map("next_of_kin_address")

  // 2. Contact & Residential Details
  residentialAddress String @map("residential_address")
  mailingAddress     String @map("mailing_address")
  primaryPhoneType   String @map("primary_phone_type")
  secondaryPhone     String? @map("secondary_phone")

  // 3. Employment & Financial Profile
  employmentStatus      String @map("employment_status")
  occupation            String @map("occupation")
  employerName          String @map("employer_name")
  employerAddress       String? @map("employer_address")
  primarySourceOfFunds  String @map("primary_source_of_funds")
  estimatedAnnualIncome String @map("estimated_annual_income")

  // 4. Identity Verification
  primaryIdType          String   @map("primary_id_type")
  idNumber               String   @map("id_number")
  stateCountryOfIssuance String   @map("state_country_of_issuance")
  issueDate              DateTime @map("issue_date")
  expirationDate         DateTime @map("expiration_date")
  idFrontDocumentUrl     String?  @map("id_front_document_url")
  idBackDocumentUrl      String?  @map("id_back_document_url")
  passportPhotoUrl       String?  @map("passport_photo_url")

  // 5. Account Configuration & Preferences
  overdraftProtection Boolean @map("overdraft_protection")
  debitCardRequest    Boolean @map("debit_card_request")
  nameToAppearOnCard  String? @map("name_to_appear_on_card")
  statementPreference String  @map("statement_preference")

  // 6. Initial Funding
  fundingMethod                String  @map("funding_method")
  externalAccountRoutingNumber String? @map("external_account_routing_number")
  externalAccountNumber        String? @map("external_account_number")
  initialDepositAmount         Float   @map("initial_deposit_amount")

  // 7. Legal Disclosures & E-Signatures
  w9Certification                    Boolean  @map("w9_certification")
  electronicCommunicationsDisclosure Boolean  @map("electronic_communications_disclosure")
  depositAccountAgreement            Boolean  @map("deposit_account_agreement")
  marketingConsent                   Boolean  @default(true) @map("marketing_consent")
  digitalSignature                   String   @map("digital_signature")
  signatureDate                      DateTime @map("signature_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accountApplication AccountApplication?
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId             String?             @unique @map("user_id")

  @@map("registration_forms")
}

model OnlineAccessRequest {
  id              String    @id @default(cuid())
  accountNumber   String    @map("account_number")
  email           String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?   @map("rejection_reason")
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("online_access_requests")
}

// -----------------------------------------------------------------------------
// Advanced Transactions
// -----------------------------------------------------------------------------

model Transaction {
  id              String    @id @default(cuid())
  accountId       String    @map("account_id")
  type            String // DEBIT, CREDIT
  transactionType String    @map("transaction_type") // LOCAL_TRANSFER, INT_WIRE, CRYPTO_WITHDRAWAL, CRYPTO_DEPOSIT
  amount          Float
  currency        String    @default("USD")
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  description     String
  reference       String    @unique
  metadata        String? // JSON string for storing Crypto Wallet Address, SWIFT/IBAN, etc.
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  accountNumber String   @map("account_number")
  bankName      String   @map("bank_name")
  swiftCode     String?  @map("swift_code")
  isInternal    Boolean  @default(false) @map("is_internal")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("beneficiaries")
}

model Card {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  cardNumber String   @unique @map("card_number")
  cardType   String   @map("card_type") // DEBIT, CREDIT
  network    String   @default("VISA")
  expiryDate DateTime @map("expiry_date")
  cvv        String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("cards")
}

model Cheque {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  chequeNumber String   @map("cheque_number")
  amount       Float?
  payeeName    String?  @map("payee_name")
  status       String   @default("ISSUED") // ISSUED, CLEARED, BOUNCED, CANCELLED
  issueDate    DateTime @default(now()) @map("issue_date")
  clearDate    DateTime? @map("clear_date")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("cheques")
}

model ChequeRequest {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  accountId       String   @map("account_id")
  numberOfLeaves  Int      @default(50) @map("number_of_leaves")
  deliveryMethod  String   @default("MAIL") @map("delivery_method") // MAIL, PICKUP
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy      String?  @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("cheque_requests")
}

// -----------------------------------------------------------------------------
// Core Banking Entities
// -----------------------------------------------------------------------------

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  targetAmount  Float    @map("target_amount")
  currentAmount Float    @default(0) @map("current_amount")
  targetDate    DateTime @map("target_date")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_goals")
}

model Payee {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  accountNumber String   @map("account_number")
  category      String   @default("OTHER")
  country       String   @default("usa")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills         Bill[]

  @@map("payees")
}

model Bill {
  id        String    @id @default(cuid())
  accountId String    @map("account_id")
  payeeId   String    @map("payee_id")
  amount    Float
  status    String    @default("PENDING") // PENDING, PAID
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payee     Payee     @relation(fields: [payeeId], references: [id], onDelete: Cascade)

  @@map("bills")
}

model Statement {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  period      String // e.g. "2026-08"
  filePath    String?  @map("file_path")
  generatedAt DateTime @default(now()) @map("generated_at")
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("statements")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model ImpersonationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("impersonation_tokens")
}

// -----------------------------------------------------------------------------
// Widgets & Analytics
// -----------------------------------------------------------------------------

model Budget {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  category  String
  limit     Float
  spent     Float    @default(0)
  color     String   @default("bg-blue-500")
  month     String   // Format: YYYY-MM
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model CreditScore {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  score     Int
  change    Int      @default(0) // Positive or negative change
  month     String   // Format: YYYY-MM
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_scores")
}
